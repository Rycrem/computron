# ==================================================================
#  Copie ce fichier en « .env » (même dossier que docker-compose.yml)
#  puis remplis les valeurs. Le fichier .env n'est JAMAIS publié
#  (il est listé dans .gitignore) : ne colle tes secrets que dedans.
# ==================================================================

# ---- Secrets (obligatoires) ---------------------------------------
# Portail développeur Discord > ton application > Bot > Reset Token
DISCORD_TOKEN=
# IPTorrents : valeur de l'en-tête « cookie » (uid=…; pass=…) copiée depuis ton navigateur
IPT_COOKIE=
# IPTorrents : valeur de l'en-tête « user-agent » du MÊME navigateur (Mozilla/5.0 …)
IPT_USERAGENT=

# ---- Dossiers sur le NAS (obligatoires) ----------------------------
# Réglages de toutes les applis (un sous-dossier par appli y sera créé)
CONFIG_DIR=/volume1/docker
# Dossier partagé des médias : Films, Séries, Anims et Téléchargements y seront créés
# (chemin exact du dossier partagé, espaces et accents compris, ex. /volume1/Films & Series)
MEDIA_DIR=/volume1/Medias
# Dossier où arrivent les mangas / manhwas (CBZ)
MANGA_DIR=/volume1/Comics

# ---- Compte qui possède les fichiers (commande « id » en SSH) ------
PUID=1000
PGID=10
TZ=Europe/Paris

# ---- Optionnel ----------------------------------------------------
# Nom exact d'un rôle Discord autorisé à utiliser le bot (vide = tout le monde)
DISCORD_ALLOWED_ROLE=
# Nombre minimum de seeders pour qu'un torrent soit choisi
MIN_SEEDERS=3
# Heure de la recherche quotidienne des films et épisodes manquants
SEARCH_HOUR=4
# Autres indexeurs Jackett PUBLICS à ajouter (identifiants séparés par des virgules)
JACKETT_INDEXERS=

# ---- Mise à jour automatique du code ------------------------------
# À chaque redémarrage, arr-bot et init récupèrent la dernière version du code sur GitHub.
# « non » pour rester sur la version installée.
MAJ_AUTO=oui
# Dépôt et branche suivis (par défaut Rycrem/computron, branche main)
CODE_REPO=
CODE_BRANCH=
# Seulement si le dépôt devient privé : jeton GitHub en lecture seule (Contents: Read)
GITHUB_TOKEN=
